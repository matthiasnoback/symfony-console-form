{
    "name": "matthiasnoback/symfony-console-form",
    "type": "library",
    "description": "Use Symfony forms for Console command input",
    "keywords": ["Symfony", "console", "form"],
    "homepage": "http://github.com/matthiasnoback/symfony-console-form",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthias Noback",
            "email": "matthiasnoback@gmail.com",
            "homepage": "http://php-and-symfony.matthiasnoback.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "Matthias\\SymfonyConsoleForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Matthias\\SymfonyConsoleForm\\Tests\\": "test/"
        }
    },
    "require": {
        "php": ">=8.1",
        "symfony/form": "~6.4 || ~7.4 || ~8.0",
        "symfony/console": "~6.4 || ~7.4 || ~8.0",
        "symfony/translation": "~6.4 || ~7.4 || ~8.0"
    },
    "require-dev": {
        "beberlei/assert": "~2.1",
        "behat/behat": "^3.6",
        "symfony/finder": "~6.4 || ~7.4 || ~8.0",
        "symfony/framework-bundle": "~6.4 || ~7.4 || ~8.0",
        "symfony/validator": "~6.4 || ~7.4 || ~8.0",
        "symfony/yaml": "~6.4 || ~7.4 || ~8.0",
        "symfony/security-csrf": "~6.4 || ~7.4 || ~8.0",
        "phpunit/phpunit": "^9.5",
        "symplify/easy-coding-standard": "^12.0",
        "symplify/coding-standard": "^12.0",
        "symfony/intl": "~6.4 || ~7.4 || ~8.0"
    }
}
